# Copy to deploy/.env.prod (gitignored) and fill in. deploy.sh uploads it to the server.
# SITE_ADDRESS, WHOOP_REDIRECT_URI and FRONTEND_URL are added automatically from the Terraform outputs.
DASHBOARD_PASSWORD=
TZ=Europe/Madrid

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
GARMIN_EMAIL=
GARMIN_PASSWORD=
ANTHROPIC_API_KEY=

AUTO_SYNC=1
AUTO_SYNC_DAY=sun
AUTO_SYNC_HOUR=23
AUTO_SYNC_MINUTE=0
