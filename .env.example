# Dashboard login (required: without it the API refuses all requests). Use a long random password.
DASHBOARD_PASSWORD=
# Optional: separate key for signing session cookies; SESSION_DAYS = how long a login lasts
SESSION_SECRET=
SESSION_DAYS=30

# Whoop (create an app at https://developer.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/auth/whoop/callback

# Garmin (unofficial garminconnect library)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional: AI coach
ANTHROPIC_API_KEY=

# Weekly auto-run (sync Whoop and Garmin, then write next week's plan). Local time of the machine running the backend.
AUTO_SYNC=1
AUTO_SYNC_DAY=sun
AUTO_SYNC_HOUR=23
AUTO_SYNC_MINUTE=0
